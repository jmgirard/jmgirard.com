---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { loadPublications, formatAuthorsHtml } from '../lib/bib.js';
import portrait from '../assets/headshot-working.jpg';

const LAB = 'https://affcom.ku.edu';

const publications = await loadPublications();

/**
 * Curated by relevance to what a client is hiring for, not by date. Each key
 * answers a different question: can he evaluate a model, does the field treat
 * him as an authority, has he done applied clinical work, can he build a
 * dataset, can he validate a measure. Edit this list to re-curate.
 */
const SELECTED = [
  'girard2026',   // LLM evaluation on naturalistic speech
  'girard2026a',  // Annual Review: authority in the field
  'girard2025',   // applied affective computing in therapy
  'girard2023a',  // DynAMoS: dataset design and collection
  'girard2021',   // measurement validation
];

const byKey = new Map(publications.map((p) => [p.key, p]));
const missing = SELECTED.filter((k) => !byKey.has(k));
if (missing.length) throw new Error(`Selected keys not in the lab bib: ${missing.join(', ')}`);
const selected = SELECTED.map((k) => byKey.get(k)).sort((a, b) => b.year.sort - a.year.sort);

/** The colours are the lab's research areas that each kind of work draws on. */
const ranges = [
  {
    name: 'AI evaluation',
    lede: 'For teams shipping systems that make claims about people.',
    color: 'var(--col-cs)',
    items: ['Dataset and benchmark design and collection', 'Model evaluation', 'Generative psychometrics'],
  },
  {
    name: 'Measurement and statistics',
    lede: 'For work that has to survive review.',
    color: 'var(--col-mh)',
    items: ['Instrument development and validation', 'Inter-rater reliability and psychometrics', 'Study design and statistical analysis'],
  },
  {
    name: 'Tooling and training',
    lede: 'For teams who want the capability in-house.',
    color: 'var(--col-meth)',
    items: ['R package and pipeline development', 'Workshops and methods training'],
  },
];

const appointments = [
  { role: 'Associate Professor of Psychology and Data Science', org: 'University of Kansas', url: 'https://psych.ku.edu' },
  { role: 'Director', org: 'Affective Communication and Computing Lab', url: LAB },
  { role: 'Principal Scientist', org: 'Fluid Concepts Research', url: 'https://fluidconcepts.ai' },
  { role: 'Co-founder', org: 'SMaRT Workshops', url: 'https://smart-workshops.com' },
];

const elsewhere = [
  { href: `${LAB}/publications.html`, title: 'Publications', note: `All ${publications.length}, with preprints, data and code where they exist.` },
  { href: `${LAB}/resources.html#datasets`, title: 'Datasets and benchmarks', note: 'Corpora and benchmarks from the lab, and how to get them.' },
  { href: `${LAB}/resources.html`, title: 'Software and courses', note: 'R packages, research tools and open course materials.' },
];
---

<Base title="Jeff Girard: measurement and evaluation for systems that make claims about people">
  <section class="wrap hero">
    <div class="hero__text">
      <p class="eyebrow">Psychology &middot; Measurement &middot; Machine learning</p>
      <h1 class="hero__name">Jeff Girard</h1>
      <p class="hero__lede">
        I work where psychological measurement meets machine learning. I build
        datasets, benchmarks and evaluations for systems that make claims about
        human behavior.
      </p>
      <p class="hero__role">
        Associate Professor of Psychology at the University of Kansas, where I
        direct the <a href={LAB}>Affective Communication &amp; Computing Lab</a>
      </p>
      <div class="btns">
        <a class="primary" href="mailto:me@jmgirard.com">Email me</a>
        <a href={LAB}>Visit the lab</a>
      </div>
    </div>
    <figure class="hero__photo">
      <Image
        src={portrait}
        alt="Jeff Girard at a workstation, looking at a monitor showing a data plot."
        widths={[420, 640, 900]}
        sizes="(max-width: 860px) 100vw, 45vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="wrap section" id="about">
    <h2 class="section-title">About</h2>
    <div class="about">
      <div class="about__prose">
        <p>
          I trained as a clinical psychologist (PhD, University of Pittsburgh,
          2018), and my research is about measuring things that resist
          measurement: emotion, clinical state, the texture of a conversation.
          That work has appeared in <em>Annual Review of Clinical Psychology</em>,
          <em>Journal of Consulting and Clinical Psychology</em> and
          <em>Affective Science</em>, and it has produced open-source tools that
          other researchers use.
        </p>
        <p>
          Through Girard Consulting I bring the same standards to applied work
          for teams building systems that reason about people. The research
          itself, and the students and staff who do it with me, live at the
          <a href={LAB}>AffCom Lab</a>.
        </p>
      </div>
      <ul class="appts">
        {appointments.map((a) => (
          <li>
            <span class="appts__role">{a.role}</span>
            <a href={a.url}>{a.org}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap section" id="work">
    <h2 class="section-title">Work with me</h2>
    <div class="ranges">
      {ranges.map((r) => (
        <article class="range" style={`--accent: ${r.color}`}>
          <h3 class="range__name">{r.name}</h3>
          <p class="range__lede">{r.lede}</p>
          <ul class="range__list">
            {r.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <div class="ask">
      <p class="ask__text">Tell me what you are trying to measure, and what would count as getting it right.</p>
      <div class="btns"><a class="primary" href="mailto:me@jmgirard.com">me@jmgirard.com</a></div>
    </div>
  </section>

  <section class="wrap section" id="papers">
    <h2 class="section-title">Selected papers</h2>
    <ol class="papers">
      {selected.map((p) => (
        <li>
          <a class="papers__title" href={`${LAB}/publications.html#${p.key}`}>{p.title}</a>
          <span class="papers__meta">
            <span set:html={formatAuthorsHtml(p.authors)} /> &middot; <em>{p.venue}</em>, {p.year.label}
          </span>
        </li>
      ))}
    </ol>

    <h3 class="more__title">More at the lab</h3>
    <ul class="more">
      {elsewhere.map((e) => (
        <li class="card">
          <a class="card__title" href={e.href}>{e.title}</a>
          <p class="card__note">{e.note}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* ---------- Hero: the lab homepage's two-column opening ---------- */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px clamp(28px, 5vw, 56px);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2rem);
  }

  .hero__name {
    font-size: clamp(2.4rem, 1.8rem + 2.4vw, 3.4rem);
    line-height: 1.05;
    margin: 12px 0 18px;
  }

  .hero__lede {
    font-size: 1.2rem;
    color: var(--ink-soft);
    margin-bottom: 12px;
    max-width: 34em;
  }

  .hero__role {
    font-size: 0.98rem;
    color: var(--muted);
    margin-bottom: 24px;
    max-width: 34em;
  }

  .hero__photo { margin: 0; }
  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about__prose { display: grid; gap: 1rem; max-width: 40em; }

  /* The lab profile page's timeline: a ruled spine with open dots. */
  .appts {
    list-style: none;
    margin: 0.2rem 0 0;
    padding-left: 1.3rem;
    border-left: 2px solid var(--line);
    display: grid;
    gap: 1rem;
  }
  .appts li { position: relative; display: grid; line-height: 1.35; }
  .appts li::before {
    content: '';
    position: absolute;
    left: calc(-1.3rem - 6px);
    top: 0.3em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--ink);
  }
  .appts__role { font-size: 0.9rem; color: var(--muted); }
  .appts a { font-weight: 600; }

  /* ---------- Work with me: the lab's opportunity cards ---------- */
  .ranges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

  .range {
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem 1.2rem;
  }

  .range__name { font-size: 1.3rem; margin-bottom: 0.4rem; }
  .range__lede { color: var(--muted); margin-bottom: 0.9rem; }

  .range__list { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; }
  .range__list li::marker { color: var(--accent); }

  .ask {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.6rem;
    padding-block: 1.2rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .ask__text {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    max-width: 30em;
  }

  /* ---------- Papers: the lab profile's short publication list ---------- */
  .papers { list-style: none; margin: 0; padding: 0; }
  .papers li { padding: 0.75rem 0; border-bottom: 1px solid var(--line); line-height: 1.4; }
  .papers__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.08rem;
    text-decoration: none;
  }
  .papers__title:hover { text-decoration: underline; }
  .papers__meta { display: block; color: var(--muted); font-size: 0.9rem; margin-top: 3px; }
  .papers__meta :global(b) { color: var(--ink); font-weight: 600; }

  .more__title { font-size: 1.2rem; margin: 2.2rem 0 1rem; }

  .more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .card {
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem 1rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(28, 26, 23, 0.1); }
  .card__title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: none;
  }
  /* The whole card is the link. */
  .card__title::after { content: ''; position: absolute; inset: 0; }
  .card__note { color: var(--ink-soft); font-size: 0.95rem; margin-top: 0.3rem; }

  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
    .card:hover { transform: none; }
  }

  /* ---------- Narrow screens ---------- */
  @media (max-width: 860px) {
    .hero, .about { grid-template-columns: 1fr; }
    .hero__photo { max-width: 520px; }
    .ranges, .more { grid-template-columns: 1fr; }
  }
</style>
