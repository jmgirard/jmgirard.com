---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { datasets, datasetSummary, ACCESS } from '../data/datasets.js';

const accessOrder = ['open', 'gated', 'request'];
const usedAccess = accessOrder.filter((a) => datasets.some((d) => d.access === a));
---

<Base
  title="Datasets and benchmarks — Jeff Girard"
  description={`Corpora and evaluation sets released between ${datasetSummary.firstYear} and ${datasetSummary.lastYear}, each stamped with how to get it and what my hand in it was.`}
  panel="datasets"
>
  <section class="head">
    <div class="chassis">
      <div class="nameplate">
        <h1 class="head__title">Data</h1>
        <p class="head__lede">
          {datasetSummary.total} corpora and evaluation sets,
          {' '}{datasetSummary.firstYear}&ndash;{datasetSummary.lastYear}. Each one says what it
          costs to get and what my hand in it was, because
          {' '}<em>co-authored</em> and <em>led</em> are not the same claim.
        </p>
      </div>

      <dl class="legend">
        {usedAccess.map((a) => (
          <div class="legend__item">
            <dt><span class={`stamp stamp--${a}`}>{ACCESS[a].short}</span></dt>
            <dd>
              <b>{ACCESS[a].label}.</b> {ACCESS[a].note}
              <span class="legend__count">{datasets.filter((d) => d.access === a).length}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="shelf">
    <hr class="seam" />
    <div class="chassis">
      <ol class="shelf__list">
        {datasets.map((d) => (
          <li class={`set set--${d.kind.toLowerCase()}`} id={d.id}>
            <div class="set__spine">
              <span class="set__year">{d.year}</span>
              <span class="engraved set__kind">{d.kind}</span>
            </div>

            <div class="set__body">
              <div class="set__top">
                <h2 class="set__name"><a href={d.url}>{d.name}</a></h2>
                <span class={`stamp stamp--${d.access}`}>{ACCESS[d.access].short}</span>
              </div>

              <p class="set__title">{d.title}</p>
              <p class="set__blurb">{d.blurb}</p>

              {d.calibration && (
                <p class="set__calibration">
                  <span class="engraved">Baselines</span>
                  {d.calibration}
                </p>
              )}

              <dl class="spec">
                <div class="spec__cell">
                  <dt class="engraved">Scale</dt>
                  <dd>{d.scale}</dd>
                </div>
                <div class="spec__cell">
                  <dt class="engraved">Modalities</dt>
                  <dd>{d.modalities.join(' · ')}</dd>
                </div>
                <div class="spec__cell">
                  <dt class="engraved">My role</dt>
                  <dd>{d.role}</dd>
                </div>
                {d.org && (
                  <div class="spec__cell">
                    <dt class="engraved">Released with</dt>
                    <dd><a href={d.org.url}>{d.org.name}</a></dd>
                  </div>
                )}
                {d.license && (
                  <div class="spec__cell">
                    <dt class="engraved">License</dt>
                    <dd>{d.license}</dd>
                  </div>
                )}
                {d.builtOn && (
                  <div class="spec__cell">
                    <dt class="engraved">Built on</dt>
                    <dd><a href={d.builtOn.url}>{d.builtOn.name}</a></dd>
                  </div>
                )}
              </dl>

              <p class="set__foot">
                <a class="set__link" href={d.url}>{d.urlLabel}<Arrow size={12} /></a>
                {d.paper && <a class="set__link" href={d.paper}>{d.paperLabel}<Arrow size={12} /></a>}
                {!d.paper && d.paperLabel && (
                  <span class="set__pending">{d.paperLabel}</span>
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="tail">
    <div class="chassis">
      <p class="tail__note">
        Building one of these is most of the work in evaluating a model honestly, and
        it is what I am usually hired for. If you need a benchmark that measures
        what you actually claim to measure, <a href="mailto:me@jmgirard.com">say so</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem); }

  .nameplate {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    align-items: end;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: var(--rule-heavy) solid var(--brass);
    border-bottom: var(--rule) solid var(--enamel-edge);
  }

  @media (max-width: 760px) {
    .nameplate { grid-template-columns: 1fr; gap: 0.9rem; align-items: start; }
  }

  .head__title {
    font-size: var(--step-4);
    font-weight: 600;
    font-stretch: 92%;
    color: #f0ece0;
  }

  .head__lede {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 48ch;
    color: var(--ink-on-enamel);
    padding-bottom: 0.3rem;
  }

  .legend {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    display: grid;
    gap: 0.85rem;
    max-width: 60ch;
  }
  .legend__item {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-top: 0.7rem;
    border-top: var(--rule) solid var(--enamel-edge);
  }
  .legend dt, .legend dd { margin: 0; }
  .legend dd {
    font-size: var(--step--1);
    color: var(--ink-on-enamel-soft);
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .legend dd b { color: var(--ink-on-enamel); font-weight: 600; }
  .legend__count { margin-left: auto; font-weight: 700; color: var(--brass); }

  /* Access stamps borrow the calibration-stamp shell but carry their own key:
     amber for the one you can have today, quiet for the ones that need asking. */
  .stamp--open { color: var(--signal); }
  .stamp--gated { color: var(--brass); }
  .stamp--request { color: var(--ink-on-enamel-soft); }

  .shelf__list { list-style: none; margin: 0; padding: 0; }

  .set {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 2.5rem);
    padding-block: clamp(1.8rem, 3.5vw, 2.8rem);
    border-bottom: var(--rule) solid var(--enamel-edge);
  }
  .set:first-child { padding-top: clamp(1.5rem, 3vw, 2.2rem); }

  .set__spine {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding-top: 0.35rem;
  }
  .set__year {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
    color: var(--brass);
    font-variant-numeric: tabular-nums;
  }
  .set__kind { font-size: var(--micro); }

  /* The benchmark is the newest work and the one being sold; it gets the lit spine. */
  .set--benchmark .set__year { color: var(--signal); }

  .set__body { display: grid; gap: 0.65rem; align-content: start; }

  .set__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .set__name { font-size: var(--step-2); font-weight: 600; font-stretch: 96%; }
  .set__name a {
    text-decoration: none;
    color: #f0ece0;
    border-bottom: var(--rule-heavy) solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .set__name a:hover { color: var(--signal); border-color: var(--signal); }

  .set__title {
    font-size: var(--step-0-sm);
    color: var(--ink-on-enamel-soft);
    margin-top: -0.3rem;
  }

  .set__blurb {
    font-family: var(--serif);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-on-enamel);
    max-width: 62ch;
  }

  .set__calibration {
    font-family: var(--serif);
    font-size: var(--step-0-sm);
    line-height: 1.55;
    color: var(--ink-on-enamel-soft);
    max-width: 62ch;
    padding-left: 0.9rem;
    border-left: var(--rule-heavy) solid var(--brass-dim);
  }
  .set__calibration .engraved {
    display: block;
    font-size: var(--micro);
    margin-bottom: 0.2rem;
  }

  .spec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    margin: 0.35rem 0 0;
    padding-top: 0.7rem;
    border-top: var(--rule) solid var(--enamel-edge);
  }
  .spec__cell { display: grid; gap: 0.1rem; }
  .spec dt { font-size: var(--micro); }
  .spec dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-on-enamel);
    font-weight: 600;
  }
  .spec dd a {
    color: var(--ink-on-enamel);
    text-decoration: none;
    border-bottom: var(--rule) solid var(--brass);
  }
  .spec dd a:hover { color: var(--signal); }

  .set__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    align-items: baseline;
    margin-top: 0.3rem;
  }

  .set__link {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--brass);
    display: inline-flex;
    gap: 0.4rem;
    transition: color 140ms ease;
  }
  .set__link:hover { color: var(--signal); }

  .set__pending {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-on-enamel-soft);
  }

  .tail { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .tail__note {
    font-family: var(--serif);
    font-size: var(--step-0);
    color: var(--ink-on-enamel-soft);
    max-width: 54ch;
  }
  .tail__note a {
    color: var(--ink-on-enamel);
    border-bottom: var(--rule) solid var(--brass);
    text-decoration: none;
  }
  .tail__note a:hover { color: var(--signal); }

  @media (max-width: 700px) {
    .set { grid-template-columns: 1fr; gap: 0.75rem; }
    .set__spine {
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
      padding-top: 0;
    }
    .set__year { font-size: var(--step-1); }
  }

  @media (max-width: 560px) {
    .legend__item { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
