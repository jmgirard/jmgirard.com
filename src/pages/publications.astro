---
import Base from '../layouts/Base.astro';
import CalibrationRule from '../components/CalibrationRule.astro';
import Arrow from '../components/Arrow.astro';
import { loadPublications, summarize, formatAuthorsHtml } from '../lib/bib.js';

const publications = loadPublications();
const summary = summarize(publications);

// Group by year, in-press first, so the record reads newest to oldest.
const byYear = [];
for (const p of publications) {
  const key = p.year.label;
  let bucket = byYear.find((b) => b.key === key);
  if (!bucket) {
    bucket = { key, slug: key.replace(' ', '-'), year: p.year, items: [] };
    byYear.push(bucket);
  }
  bucket.items.push(p);
}

const pageDescription =
  `The complete record: ${summary.total} publications from ${summary.firstYear} to ` +
  `${summary.lastYear}, with preprints and materials linked wherever they exist.`;

const readings = [
  { v: summary.total, l: 'Total' },
  { v: summary.journals, l: 'Journal articles' },
  { v: summary.conferences, l: 'Conference papers' },
  { v: summary.labLed, l: 'Lab-led' },
];
---

<Base
  title="Publication record — Jeff Girard"
  description={pageDescription}
  panel="publications"
>
  <section class="head">
    <div class="chassis">
      <div class="nameplate">
        <h1 class="head__title">Publications</h1>
        <p class="head__lede">
        The complete record, not a selection. Where an open preprint or the
        data and code exist, they are linked &mdash; {summary.withPreprint} and
        {' '}{summary.withMaterials} of them respectively.
      </p>
      </div>
    </div>

    <div class="chassis head__rule">
      <CalibrationRule publications={publications} summary={summary} />

      <p class="readout">
        <span class="readout__item"><b class="readout__n">{summary.total}</b>total</span>
        <span class="readout__item"><b class="readout__n">{summary.journals}</b>journal articles</span>
        <span class="readout__item"><b class="readout__n">{summary.conferences}</b>conference papers</span>
        <span class="readout__item"><b class="readout__n">{summary.labLed}</b>lab-led</span>
      </p>
    </div>
  </section>

  <nav class="index" aria-label="Jump to year">
    <div class="chassis index__inner">
      <span class="engraved index__label">Jump to</span>
      <ul class="index__list">
        {byYear.map((b) => (
          <li><a href={`#y${b.slug}`}>{b.key}<span class="index__n">{b.items.length}</span></a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="record">
    <div class="chassis">
      {byYear.map((bucket) => (
        <section class="year" id={`y${bucket.slug}`}>
          <h2 class="year__label">
            <span>{bucket.key}</span>
            <span class="year__count engraved">{bucket.items.length}</span>
            <a class="year__top" href="#main">Top<Arrow size={12} /></a>
          </h2>

          <ol class="year__list">
            {bucket.items.map((p) => (
              <li class={`entry ${p.labLed ? 'entry--lab' : ''}`}>
                {p.labLed && <span class="entry__flag engraved">Lab-led</span>}
                <h3 class="entry__title">
                  {p.doiUrl && <a href={p.doiUrl}>{p.title}</a>}
                  {!p.doiUrl && <span>{p.title}</span>}
                </h3>
                <p class="entry__authors" set:html={formatAuthorsHtml(p.authors, 10)}></p>
                <p class="entry__venue">
                  <em>{p.venue}</em>
                  {p.volume && <span>, {p.volume}</span>}
                  {p.number && <span>({p.number})</span>}
                  {p.pages && <span>, {p.pages}</span>}
                </p>
                <p class="entry__links">
                  {p.doiUrl && <a href={p.doiUrl}>DOI</a>}
                  {p.preprint && <a href={p.preprint}>Preprint</a>}
                  {p.materials && <a href={p.materials}>Materials</a>}
                  {!p.doiUrl && !p.preprint && !p.materials && (
                    <span class="entry__nolink">No open link on record</span>
                  )}
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); }

  .nameplate {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3.5rem);
    align-items: end;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-top: var(--rule-heavy) solid var(--brass);
    border-bottom: var(--rule) solid var(--enamel-edge);
  }

  @media (max-width: 760px) {
    .nameplate { grid-template-columns: 1fr; gap: 0.9rem; align-items: start; }
  }

  .head__title {
    font-size: var(--step-4);
    font-weight: 600;
    font-stretch: 92%;
    color: #f0ece0;
  }

  .head__lede {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 52ch;
    color: var(--ink-on-enamel);
    padding-bottom: 0.3rem;
  }

  .head__rule { padding-top: clamp(2rem, 4vw, 3rem); }

  .index {
    position: sticky;
    top: var(--chrome-h);
    z-index: 20;
    background: color-mix(in srgb, var(--enamel-lit) 96%, transparent);
    backdrop-filter: blur(6px);
    border-block: var(--rule) solid var(--enamel-edge);
  }
  .index__inner {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.6rem;
  }
  .index__label { flex: none; font-size: var(--micro-sm); }
  .index__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.75rem;
    margin: 0;
    padding: 0;
  }

  /* One scrolling row on narrow screens, so the bar's height stays knowable
     and the year headings below it can stick at a fixed offset. */
  @media (max-width: 720px) {
    .index__inner { gap: 0.6rem; }
    .index__label { display: none; }
    .index__list {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 0.9rem;
      padding-block: 0.1rem;
      -webkit-overflow-scrolling: touch;
    }
    .index__list::-webkit-scrollbar { display: none; }
    .index__list li { flex: none; }
  }
  .index__list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    font-size: var(--micro-lg);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-on-enamel-soft);
    padding: 0.15rem 0;
    border-bottom: var(--rule-heavy) solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .index__list a:hover { color: var(--signal); border-color: var(--signal); }
  .index__n { font-size: var(--micro-sm); color: var(--brass); }

  .year__top {
    font-size: var(--micro-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 1rem;
  }
  .year__top:hover { color: var(--signal); }
  .year__top :global(.arrow) { transform: rotate(-90deg); }


  .record { padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem); }

  .year { padding-top: clamp(1.75rem, 3vw, 2.75rem); }

  .year__label {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 88%;
    color: var(--brass);
    padding-bottom: 0.75rem;
    border-bottom: var(--rule-heavy) solid var(--brass-dim);
    position: sticky;
    top: calc(var(--chrome-h) + var(--index-h));
    background: var(--enamel);
    z-index: 5;
  }
  .year__count { margin-left: auto; font-size: var(--micro-lg); }

  .year__list { list-style: none; margin: 0; padding: 0; }

  .entry {
    padding-block: clamp(1.15rem, 2vw, 1.6rem);
    border-bottom: var(--rule) solid var(--enamel-edge);
    position: relative;
  }

  /* Lab-led entries carry a brass edge, matching the amber ticks on the rule. */
  .entry--lab {
    padding-left: clamp(0.85rem, 2vw, 1.35rem);
    border-left: var(--rule) solid var(--signal);
  }

  .entry__flag {
    display: inline-block;
    font-size: var(--micro-sm);
    color: var(--signal);
    margin-bottom: 0.4rem;
  }

  .entry__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.28;
    max-width: 58ch;
    color: #ece8dc;
  }
  .entry__title a {
    text-decoration: none;
    border-bottom: var(--rule) solid var(--brass-dim);
    padding-bottom: 2px;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .entry__title a:hover { color: var(--signal); border-color: var(--signal); }

  .entry__authors {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-on-enamel-soft);
    margin-top: 0.5rem;
    max-width: 78ch;
  }
  .entry__authors :global(b) { color: var(--ink-on-enamel); font-weight: 700; }

  .entry__venue {
    font-family: var(--serif);
    font-size: var(--step-0-sm);
    color: var(--ink-on-enamel-soft);
    margin-top: 0.2rem;
  }

  .entry__links {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.7rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .entry__links a {
    font-size: var(--micro);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--brass);
    border: var(--rule) solid var(--brass-dim);
    padding: 0.18rem 0.45rem;
    transition: color 140ms ease, border-color 140ms ease, background 140ms ease;
  }
  .entry__links a:hover {
    color: var(--enamel-deep);
    background: var(--signal);
    border-color: var(--signal);
  }
  .entry__nolink {
    font-size: var(--micro);
    letter-spacing: 0.06em;
    color: var(--ink-on-enamel-faint);
    font-style: italic;
  }

  @media (max-width: 560px) {
    .entry--lab { padding-left: 0.75rem; }
    .year__label { font-size: var(--step-1); }
    .entry__title { font-size: var(--step-0); }
  }
</style>
