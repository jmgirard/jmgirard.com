---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/software', label: 'Software' },
  { href: '/publications', label: 'Publications' },
];
---

<header class="chrome">
  <div class="chassis chrome__inner">
    <a class="chrome__plate" href="/" aria-label="Jeff Girard — home">
      <span class="chrome__name">Jeff Girard</span>
      <span class="engraved chrome__sub">Measurement &amp; evaluation</span>
    </a>

    <nav class="chrome__nav" aria-label="Sections">
      {links.map((l) => {
        const current = path === l.href;
        return (
          <a href={l.href} class="chrome__link" aria-current={current ? 'page' : undefined}>
            <span class="chrome__tick" aria-hidden="true"></span>
            {l.label}
          </a>
        );
      })}
    </nav>

    <a class="chrome__contact engraved" href="mailto:me@jmgirard.com">me@jmgirard.com</a>
  </div>
  <hr class="seam" />
</header>

<style>
  .chrome {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--enamel-deep) 92%, transparent);
    backdrop-filter: blur(6px);
  }

  .chrome__inner {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 0.7rem;
  }

  .chrome__plate {
    display: grid;
    text-decoration: none;
    line-height: 1.1;
    padding-right: clamp(1rem, 3vw, 2rem);
    border-right: var(--rule) solid var(--enamel-edge);
  }

  .chrome__name {
    font-weight: 700;
    font-stretch: 92%;
    letter-spacing: -0.01em;
    color: var(--ink-on-enamel);
  }

  .chrome__sub { font-size: var(--micro); letter-spacing: 0.18em; margin-top: 0.15rem; }

  .chrome__nav {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 2rem);
    margin-right: auto;
  }

  .chrome__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
    font-stretch: 88%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-on-enamel-soft);
    padding-block: 0.35rem;
    transition: color 140ms ease;
  }
  .chrome__link:hover { color: var(--ink-on-enamel); }

  /* The selected channel is the lit one. */
  .chrome__tick {
    width: 2px;
    height: 11px;
    background: var(--brass-dim);
    transition: background 140ms ease, box-shadow 140ms ease;
  }
  .chrome__link:hover .chrome__tick { background: var(--brass); }
  .chrome__link[aria-current='page'] { color: var(--signal); }
  .chrome__link[aria-current='page'] .chrome__tick {
    background: var(--signal);
    box-shadow: 0 0 7px 1px rgba(232, 163, 61, 0.65);
  }

  .chrome__contact {
    text-decoration: none;
    font-size: var(--micro-lg);
    transition: color 140ms ease;
  }
  .chrome__contact:hover { color: var(--signal); }

  @media (max-width: 720px) {
    .chrome__inner { flex-wrap: wrap; gap: 0.6rem 1rem; padding-block: 0.55rem; }
    .chrome__plate { border-right: 0; padding-right: 0; }
    .chrome__contact { display: none; }
    .chrome__nav { width: 100%; order: 3; margin-right: 0; justify-content: space-between; }
  }
</style>
