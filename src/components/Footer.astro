---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <p>&copy; {year} Jeffrey M. Girard &middot; Consulting through Girard Consulting LLC</p>
    <p class="foot__links">
      <a href="mailto:me@jmgirard.com">me@jmgirard.com</a>
      <a href="https://github.com/jmgirard">GitHub</a>
      <a href="https://scholar.google.com/citations?user=N2UcZ84AAAAJ">Google Scholar</a>
      <a href="https://affcom.ku.edu">AffCom Lab</a>
    </p>
  </div>
</footer>

<style>
  .foot {
    background: var(--paper-2);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .foot__inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    padding-block: 1.4rem;
  }

  .foot__links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
</style>
