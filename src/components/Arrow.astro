---
/** Drawn arrow in the chassis line weight — never a Unicode glyph. */
const { size = 14 } = Astro.props;
---
<svg
  class="arrow"
  width={size}
  height={size}
  viewBox="0 0 14 14"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <line x1="1" y1="7" x2="12" y2="7" />
  <polyline points="8,3 12,7 8,11" />
</svg>

<style>
  .arrow {
    flex: none;
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  a:hover > .arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .arrow { transition: none; }
  }
</style>
